{
    "@context": [
        {
            "door": "https://secorolab.github.io/models/door#"
        },
        "https://comp-rob2b.github.io/metamodels/geometry/structural-entities.json",
        "https://comp-rob2b.github.io/metamodels/geometry/coordinates.json",
        "https://comp-rob2b.github.io/metamodels/geometry/spatial-relations.json",
        "https://comp-rob2b.github.io/metamodels/qudt.json",
        "https://secorolab.github.io/metamodels/geometry/polytope.json",
        "https://secorolab.github.io/metamodels/geometry/coordinates.json"
    ],
    "@graph": [ 
        {
            "@id": "door:hinge-jamb-origin",
            "@type": [ "3D", "Euclidean", "Point" ]
        },
        {
            "@id": "door:hinge-jamb-frame",
            "@type": [ "3D", "Euclidean", "Frame", "Orthonormal", "RigidBody", "RightHanded" ],
            "origin": "door:hinge-jamb-origin"
        },
        {
            "@id": "door:joint-door-hinge-origin",
            "@type": [ "3D", "Euclidean", "Point" ]
        },
        {
            "@id": "door:joint-door-hinge-joint-vector-x",
            "@type": [ "3D", "Euclidean", "Vector", "BoundVector", "UnitLength" ],
            "start": "door:joint-door-hinge-origin"
        },
        {
            "@id": "door:joint-door-hinge-joint-vector-y",
            "@type": [ "3D", "Euclidean", "Vector", "BoundVector", "UnitLength" ],
            "start": "door:joint-door-hinge-origin"
        },
        {
            "@id": "door:joint-door-hinge-joint-vector-z",
            "@type": [ "3D", "Euclidean", "Vector", "BoundVector", "UnitLength" ],
            "start": "door:joint-door-hinge-origin"
        },
        {
            "@id": "door:joint-door-hinge-frame",
            "@type": ["3D", "Euclidean", "Frame", "Orthonormal", "RigidBody", "RightHanded", "OriginVectorsXYZ"],
            "origin": "door:joint-door-hinge-origin",
            "vector-x": "door:joint-door-hinge-joint-vector-x",
            "vector-y": "door:joint-door-hinge-joint-vector-y",
            "vector-z": "door:joint-door-hinge-joint-vector-z"
        },
        {
            "@id": "door:door-hinge-stile-origin",
            "@type": [ "3D", "Euclidean", "Point" ]
        },
        {
            "@id": "door:door-hinge-stile-vector-x",
            "@type": [ "3D", "Euclidean", "Vector", "BoundVector", "UnitLength" ],
            "start": "door:door-hinge-stile-origin"
        },
        {
            "@id": "door:door-hinge-stile-vector-y",
            "@type": [ "3D", "Euclidean", "Vector", "BoundVector", "UnitLength" ],
            "start": "door:door-hinge-stile-origin"
        },
        {
            "@id": "door:door-hinge-stile-vector-z",
            "@type": [ "3D", "Euclidean", "Vector", "BoundVector", "UnitLength" ],
            "start": "door:door-hinge-stile-origin"
        },
        {
            "@id": "door:door-hinge-stile-frame",
            "@type": ["3D", "Euclidean", "Frame", "Orthonormal", "RigidBody", "RightHanded", "OriginVectorsXYZ"],
            "origin": "door:door-hinge-stile-origin",
            "vector-x": "door:door-hinge-stile-vector-x",
            "vector-y": "door:door-hinge-stile-vector-y",
            "vector-z": "door:door-hinge-stile-vector-z"
        },
        {
            "@id": "door:door-object-origin",
            "@type": [ "3D", "Euclidean", "Point" ]
        },
        {
            "@id": "door:door-object-frame",
            "@type": "Frame",
            "origin": "door:door-object-origin"
        },
        {
            "@id": "door:door-panel-center-origin",
            "@type": [ "3D", "Euclidean", "Point" ]
        },
        {
            "@id": "door:door-panel-center-frame",
            "@type": "Frame",
            "origin": "door:door-panel-center-origin"
        },
        {
            "@id": "door:hinge-jamb",
            "@type": [ "SimplicialComplex", "RigidBody" ],
            "simplices": [
                "door:hinge-jamb-frame",
                "door:joint-door-hinge-frame",
                "door:joint-door-hinge-origin",
                "door:joint-door-hinge-joint-vector-x",
                "door:joint-door-hinge-joint-vector-y",
                "door:joint-door-hinge-joint-vector-z"
            ]
        },
        {
            "@id": "door:door-panel",
            "@type": [ "SimplicialComplex", "RigidBody" ],
            "simplices": [
                "door:door-hinge-stile-frame",
                "door:door-hinge-stile-origin",
                "door:door-hinge-stile-vector-x",
                "door:door-hinge-stile-vector-y",
                "door:door-hinge-stile-vector-z"
            ]
        },
        {
            "@id": "door:pose-hinge-jamb-frame-wrt-door-object-frame",
            "@type": "Pose",
            "of": "door:hinge-jamb-frame",
            "with-respect-to": "door:door-object-frame"
        },
        {
            "@id": "door:pose-joint-door-hinge-frame-wrt-hinge-jamb-frame",
            "@type": "Pose",
            "of": "door:joint-door-hinge-frame",
            "with-respect-to": "door:hinge-jamb-frame",
            "quantity-kind": [ "Angle", "Length" ]
        },
        {
            "@id": "door:pose-door-hinge-stile-frame-wrt-joint-door-hinge-frame",
            "@type": "Pose",
            "of": "door:door-hinge-stile-frame",
            "with-respect-to": "door:joint-door-hinge-frame",
            "quantity-kind": [ "Angle", "Length" ]
        },
        {
            "@id": "door:pose-door-panel-center-frame-wrt-door-hinge-stile-frame",
            "@type": "Pose",
            "of": "door:door-panel-center-frame",
            "with-respect-to": "door:door-hinge-stile-frame",
            "quantity-kind": [ "Angle", "Length" ]
        },
        {
            "@id": "door:coord-pose-hinge-jamb-frame-wrt-object-door-frame",
            "@type": [
                "PoseReference",
                "PoseCoordinate",
                "VectorXYZ",
                "EulerAngles"
            ],
            "unit": ["M", "RAD"],
            "of-pose": "door:pose-hinge-jamb-frame-wrt-door-object-frame",
            "as-seen-by": "door:door-object-frame",
            "x": 0,
            "y": 0,
            "z": 0.995,
            "alpha": 0
        },
        {
            "@id": "door:coord-pose-joint-door-hinge-frame-wrt-hinge-jamb-frame",
            "@type": [
                "PoseReference",
                "PoseCoordinate",
                "VectorXYZ",
                "EulerAngles"
            ],
            "unit": ["M", "RAD"],
            "of-pose": "door:pose-joint-door-hinge-frame-wrt-hinge-jamb-frame",
            "as-seen-by": "door:hinge-jamb-frame",
            "x": -0.025,
            "y": 0.025,
            "z": 0,
            "alpha": 0
        },
        {
            "@id": "door:coord-pose-door-hinge-stile-frame-wrt-joint-door-hinge-frame",
            "@type": [
                "PoseReference",
                "PoseCoordinate",
                "VectorXYZ",
                "EulerAngles"
            ],
            "unit": ["M", "RAD"],
            "of-pose": "door:pose-door-hinge-stile-frame-wrt-joint-door-hinge-frame",
            "as-seen-by": "door:joint-door-hinge-frame",
            "x": 0,
            "y": 0,
            "z": 0,
            "alpha": 0
        },
        {
            "@id": "door:coord-pose-door-panel-center-frame-wrt-door-hinge-stile-frame",
            "@type": [
                "PoseReference",
                "PoseCoordinate",
                "VectorXYZ",
                "EulerAngles"
            ],
            "unit": ["M", "RAD"],
            "of-pose": "door:pose-door-panel-center-frame-wrt-door-hinge-stile-frame",
            "as-seen-by": "door:door-hinge-stile-frame",
            "x": 0.025,
            "y": 0.465,
            "z": 0.005,
            "alpha": 0
        },


        {
            "@id": "door:door-body-polytope",
            "@type": ["Polytope", "3DPolytope", "CuboidWithSize"],
            "unit": "M",
            "x-size": 0.05,
            "y-size": 0.93,
            "z-size": 1.98
        },
        {
            "@id": "door:hinge-jamb-polytope",
            "@type": ["Polytope", "3DPolytope", "CuboidWithSize"],
            "unit": "M",
            "x-size": 0.05,
            "y-size": 0.05,
            "z-size": 1.99
        }
    ]
}